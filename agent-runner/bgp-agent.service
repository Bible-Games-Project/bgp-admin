[Unit]
Description=bgp-agent: the build server behind the BGP console's Build chat
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=bgp-agent
Group=bgp-agent
EnvironmentFile=/etc/bgp-agent.env
# Node, git and ssh wherever the machine has them (the home server has Node in /usr/local/bin)
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/bgp-agent
ExecStart=/usr/bin/env node /opt/bgp-agent/runner.mjs
Restart=always
RestartSec=15
# The service itself only waits and runs git, so it never needs much. If the machine runs
# out of memory, the kernel stops it before the machine's other services. Claude's
# containers have the same priority (runner.mjs) and their own limit (AGENT_MEMORY).
MemoryMax=512M
OOMScoreAdjust=1000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
