# Example environment variables
# Copy .env.local.example to .env.local and fill in your secrets

# GitHub Personal Access Token (for deployment workflows, and for creating
# new repos in the Bible-Games-Project org from Apps -> New app -> Create new repo)
# Get one from: https://github.com/settings/tokens
# Requires the classic "repo" and "workflow" scopes.
GITHUB_PAT="your-github-personal-access-token-here"
